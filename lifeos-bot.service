[Unit]
Description=LifeOS Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=azureuser
Group=azureuser
WorkingDirectory=/home/azureuser/lifeos-bot
EnvironmentFile=/home/azureuser/lifeos-bot/.env
ExecStart=/usr/bin/python3 /home/azureuser/lifeos-bot/app.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
