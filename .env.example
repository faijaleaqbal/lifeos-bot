# Bot
BOT_TOKEN=your_telegram_bot_token_from_botfather
ADMIN_ID=your_telegram_user_id

# Database
DATABASE_URL=sqlite+aiosqlite:///data/lifeos.db

# Timezone
TIMEZONE=Asia/Kolkata

# Google Sheets (Expenses)
GOOGLE_SHEETS_CREDENTIALS_FILE=credentials/google_sheets.json
GOOGLE_SHEETS_ID=your_sheet_id

# Notion (Quick Capture)
NOTION_TOKEN=secret_xxx
NOTION_DATABASE_ID=xxx

# OpenWeatherMap
OPENWEATHER_API_KEY=xxx
WEATHER_CITY=Malda,IN

# NewsAPI
NEWS_API_KEY=xxx

# Google Calendar
GOOGLE_CALENDAR_CREDENTIALS_FILE=credentials/google_calendar.json
GOOGLE_CALENDAR_TOKEN_FILE=credentials/calendar_token.json

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log